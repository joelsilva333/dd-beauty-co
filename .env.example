# ---------------------------------------------------------------
# Deodália Dias — Beauty & Co. · variáveis de ambiente do SITE (Vercel)
# Copiar para .env e preencher. Tudo o que está vazio é opcional:
# sem essas chaves o site funciona, só sem essa integração.
# ---------------------------------------------------------------

# Base de dados PostgreSQL (ex: Neon). Obrigatório.
DATABASE_URL="postgresql://utilizador:password@host:5432/deodalia?sslmode=require"

# Sessão do painel admin. Obrigatório em produção (gerar: openssl rand -base64 32).
ADMIN_SESSION_SECRET=""

# Endereço público do site (usado nos links das mensagens).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contactos de apoio mostrados no site.
NEXT_PUBLIC_WHATSAPP_NUMBER="244900000000"
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY="+244 900 000 000"
NEXT_PUBLIC_SUPPORT_EMAIL="ola@deodaliadias.co.ao"

# --- Stripe (cartões internacionais) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Eventos a ativar no webhook: checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed

# --- BitPay (pagamento local — https://developers.bitpay.ao) ---
# Sem BITPAY_SECRET_KEY: modo manual (a equipa confirma o pagamento no painel).
# Sandbox: https://api-sandbox.bitpay.ao/v1 · Produção (após certificação EMIS): https://api.bitpay.ao/v1
BITPAY_BASE_URL="https://api-sandbox.bitpay.ao/v1"
BITPAY_SECRET_KEY=""
# Não é usada pelo site (os pagamentos são criados no servidor); guardada para referência.
BITPAY_PUBLISHABLE_KEY=""
# whsec_… devolvido ao registar o webhook <site>/api/webhooks/bitpay no painel BitPay.
BITPAY_WEBHOOK_SECRET=""

# --- Tempo real (servidor socket.io no Render, pasta /realtime) ---
# A mesma REALTIME_SECRET tem de estar definida no Render.
REALTIME_SECRET=""
REALTIME_SERVER_URL="http://localhost:4000"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"

# --- Notificações automáticas ---
# Email (Resend) — o domínio do remetente tem de estar verificado no Resend.
RESEND_API_KEY=""
EMAIL_FROM="Deodália Dias <pedidos@deodaliadias.co.ao>"
# Recebe um email por cada nova encomenda.
ADMIN_NOTIFY_EMAIL=""

# WhatsApp (Meta WhatsApp Cloud API).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Modelo aprovado pela Meta com uma variável {{1}} no corpo (obrigatório para
# mensagens enviadas fora da janela de 24h de conversa).
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="pt_PT"

# SMS (Twilio) — usado apenas quando o WhatsApp não está configurado.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Fotos de produto (Uploadthing) ---
# Token da app Uploadthing da Deodália (painel uploadthing.com → API Keys).
UPLOADTHING_TOKEN=""
